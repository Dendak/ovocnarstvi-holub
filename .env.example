# Přístup k datům e-shopu na serveru (složka api/data na Wedosu) přes samostatný FTP účet omezený jen na tuto složku.
# Zkopírujte jako .env a doplňte. Soubor .env je v .gitignore – nikdy ho necommitujte (repo je veřejné).
# Používá ho scripts/data-serveru.sh.
DATA_FTP_HOST=
DATA_FTP_USER=
DATA_FTP_HESLO=
# 1 = šifrované spojení (FTPS), 0 = bez šifrování (jen když ho Wedos neumožní)
DATA_FTP_TLS=1
